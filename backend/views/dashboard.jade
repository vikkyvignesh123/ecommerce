doctype html
html
  head
    title Ecommerce Dashboard
    link(rel="stylesheet", href="/static/css/Dashboard.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css")
  body
    // ✅ Success alert container (hidden initially)
    #successAlert.hidden(style="position: fixed; top: 20px; right: 20px; background-color: #4caf50; color: white; padding: 10px 20px; border-radius: 5px; box-shadow: 0 0 10px rgba(0,0,0,0.2); z-index: 9999;")
      | Registration successful! 🎉

    section#home
      header
        .logo#logosection
          img#logoimg(src="/", alt="Logo")
          // ✅ Navbar welcome text
          p#logoname Welcome, Guest

        .search
          input(type="text", placeholder="Search For product")
          i.bi.bi-search

        .navstatus
         a(href="/cart")
          a(href="#")
            i#cart.bi.bi-cart
            span#cart-count 0

          .divWrapper(style="position: relative; display: inline-block;")
            button#burgerbutton ☰ Menu
            #buttondetails
              ul
                li
                  a#loginstatus(href="#") Login
                li
                  a#homeid(href="/api/v1/cart/getdashboard") Home
                li
                  a#profileid(href="#") Profile
                li
                  a#aboutid(href="#") About

      #highlight

      main
        .products
          img(src="/static/img/airpods.jpg", alt="Airpods")
          p AIRPODS
          h2 Price : $300

        .products
          img(src="/static/img/pexels-elkady-6958875.jpg", alt="Perfume")
          p PERFUME
          h2 Price : $500

        .products
          img(src="/static/img/pexels-esmihel-18311089.jpg", alt="Laptop")
          p LAPTOP
          h2 Price : $700

      #productList

    section#indualDetails.hidden
    section#paymentPage.hidden

    button#openRegPopupBtn(type="button") Register

    #Regpopup.popup.hidden
      .RegForm
        button#regclosebtn(style="position: absolute; top: 5px; right: 10px; background: none; border: none; font-size: 20px;") ❌
        h2 Register
        form#registerForm
          input#regUsername(type="text", name="username", placeholder="Username", required)
          input#regemail(type="email", name="email", placeholder="Enter Email", required)
          input#regPassword(type="password", name="password", placeholder="Password", required)
          button#registerbutton(type="submit") Register
        p
          | Already have an account? 
          a#gotoLogin(href="#") Login

    #background.popup.hidden
        .RegForm
          button#loginclosebtn(style="position: absolute; top: 5px; right: 10px; background: none; border: none; font-size: 20px;") ❌
          h2 Login
          form#loginForm
            input#loginEmail(type="email", name="email", placeholder="Enter Email", required)
            input#loginPassword(type="password", name="password", placeholder="Enter Password", required)
            button(type="submit") Login
          p
            | Don't have an account? 
            a#gotoRegister(href="#") Register

    
    script(src="/static/ecommercejs/new.js")
    script(src="/static/ecommercejs/newscript.js")
